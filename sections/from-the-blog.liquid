{% liquid
  assign blog_obj = blank
  if section.settings.blog != blank
    assign blog_obj = blogs[section.settings.blog]
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} from-the-blog color-{{ section.settings.color_scheme }} spacing-style"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  <div class="from-the-blog__inner">
    <div class="from-the-blog__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="from-the-blog__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.button_text != blank -%}
        <a
          {% if section.settings.button_url != blank %}
            href="{{ section.settings.button_url }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
          class="from-the-blog__cta from-the-blog__cta--desktop"
        >
          {{ section.settings.button_text }}
        </a>
      {%- endif -%}
    </div>

    {%- if blog_obj != blank and blog_obj.articles_count > 0 -%}
      <div class="from-the-blog__grid">
        {%- for article in blog_obj.articles limit: section.settings.posts_to_show -%}
          {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
          {%- assign reading_time = word_count | divided_by: 200 | at_least: 1 -%}
          <a href="{{ article.url }}" class="from-the-blog__card">
            {%- if article.image != blank -%}
              <div class="from-the-blog__image-wrapper">
                {%- assign card_sizes = '(min-width: 750px) 33vw, 100vw' -%}
                {{
                  article.image
                  | image_url: width: article.image.width
                  | image_tag:
                    sizes: card_sizes,
                    widths: '354,494,550,750,988',
                    loading: 'lazy',
                    class: 'from-the-blog__image',
                    alt: article.image.alt
                }}
              </div>
            {%- endif -%}
            <div class="from-the-blog__info">
              <p class="from-the-blog__meta">
                {%- if article.tags.size > 0 -%}
                  {{ article.tags.first }} &bull; {{ reading_time }} min read
                {%- else -%}
                  {{ reading_time }} min read
                {%- endif -%}
              </p>
              <h3 class="from-the-blog__title">{{ article.title }}</h3>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if section.settings.mobile_button_text != blank -%}
        <div class="from-the-blog__mobile-cta-wrapper">
          <a
            {% if section.settings.button_url != blank %}
              href="{{ section.settings.button_url }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
            class="from-the-blog__cta from-the-blog__cta--mobile"
          >
            {{ section.settings.mobile_button_text }}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="from-the-blog__empty">Select a blog in the theme editor to display articles.</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* Inner wrapper */
  .from-the-blog__inner {
    max-width: var(--normal-page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
    display: flex;
    flex-direction: column;
    gap: 24px;

    @media screen and (min-width: 750px) {
      gap: 32px;
    }
  }

  /* Header row */
  .from-the-blog__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Section heading */
  .from-the-blog__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 26px;
    line-height: 34px;
    letter-spacing: -0.52px;
    color: var(--color-foreground);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 42px;
      line-height: 55px;
      letter-spacing: -0.84px;
    }
  }

  /* Desktop CTA (outlined pill) */
  .from-the-blog__cta--desktop {
    display: none;

    @media screen and (min-width: 750px) {
      display: inline-flex;
      flex-shrink: 0;
      justify-content: center;
      align-items: center;
      font-family: var(--font-body--family);
      font-weight: 400;
      font-size: 16px;
      line-height: 23px;
      white-space: nowrap;
      text-decoration: none;
      color: var(--color-foreground);
      background: transparent;
      border: 1px solid var(--color-foreground);
      border-radius: 57px;
      padding: 10px 34px 13px;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease;

      &:hover {
        background-color: var(--color-foreground);
        color: var(--color-background);
      }
    }
  }

  /* Mobile CTA wrapper */
  .from-the-blog__mobile-cta-wrapper {
    display: flex;
    justify-content: center;

    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  /* Mobile CTA (filled pill) */
  .from-the-blog__cta--mobile {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    text-decoration: none;
    text-align: center;
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: 1px solid var(--color-primary-button-border);
    border-radius: 60px;
    padding: 10px 24px 12px;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;

    &:hover {
      background-color: var(--color-primary-button-hover-background);
      color: var(--color-primary-button-hover-text);
      border-color: var(--color-primary-button-hover-border);
    }
  }

  /* Article grid */
  .from-the-blog__grid {
    display: flex;
    flex-direction: column;
    gap: 32px;

    @media screen and (min-width: 750px) {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }

  /* Article card */
  .from-the-blog__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-decoration: none;
    color: inherit;

    @media screen and (min-width: 750px) {
      gap: 32px;
    }
  }

  /* Image wrapper */
  .from-the-blog__image-wrapper {
    overflow: hidden;
    aspect-ratio: 354 / 260;
    background-color: #D3D8DD;

    @media screen and (min-width: 750px) {
      aspect-ratio: 1 / 1;
    }
  }

  .from-the-blog__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Card info */
  .from-the-blog__info {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Meta text */
  .from-the-blog__meta {
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: 10px;
    line-height: 14px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 14px;
      line-height: 20px;
      letter-spacing: 0.56px;
    }
  }

  /* Card title */
  .from-the-blog__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 22px;
    line-height: 29px;
    letter-spacing: -0.22px;
    color: var(--color-foreground);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 36px;
      line-height: 47px;
      letter-spacing: -0.36px;
    }
  }

  /* Empty state */
  .from-the-blog__empty {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 23px;
    color: var(--color-foreground);
    text-align: center;
    margin: 0;
    padding: 40px 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "From the Blog",
  "tag": "section",
  "class": "from-the-blog-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Posts to show",
      "min": 3,
      "max": 9,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View All"
    },
    {
      "type": "text",
      "id": "mobile_button_text",
      "label": "Mobile button text",
      "default": "View All Articles"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "full-width",
          "label": "Full width"
        },
        {
          "value": "page-width",
          "label": "Page width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "From the Blog"
    }
  ]
}
{% endschema %}
