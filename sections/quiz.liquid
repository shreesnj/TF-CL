<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} quiz color-{{ section.settings.color_scheme }} spacing-style"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  <div class="quiz__split">
    {%- comment -%} Content panel (left on desktop, below on mobile) {%- endcomment -%}
    <div class="quiz__content">
      <div class="quiz__text-group">
        {%- if section.settings.subtitle != blank -%}
          <p class="quiz__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="quiz__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="quiz__body">{{ section.settings.body }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.contaminants_label != blank or section.settings.contaminants_list != blank -%}
        <div class="quiz__card">
          <div class="quiz__card-text">
            {%- if section.settings.contaminants_label != blank -%}
              <p class="quiz__card-label">{{ section.settings.contaminants_label }}</p>
            {%- endif -%}
            {%- if section.settings.contaminants_list != blank -%}
              <p class="quiz__card-list">{{ section.settings.contaminants_list }}</p>
            {%- endif -%}
          </div>
          <div class="quiz__card-divider" aria-hidden="true"></div>
          <div class="quiz__card-icon" aria-hidden="true">
            <svg width="46" height="46" viewBox="0 0 46 46" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g stroke="#202635" stroke-width="0.75" transform="translate(23, 23)">
                <line y1="-23" y2="23"/>
                <line x1="-23" x2="23"/>
                <line y1="-23" y2="23" transform="rotate(45)"/>
                <line y1="-23" y2="23" transform="rotate(90)"/>
                <line y1="-18" y2="18" transform="rotate(22.5)"/>
                <line y1="-18" y2="18" transform="rotate(67.5)"/>
                <line y1="-18" y2="18" transform="rotate(112.5)"/>
                <line y1="-18" y2="18" transform="rotate(157.5)"/>
                <line y1="-12" y2="12" transform="rotate(11.25)"/>
                <line y1="-12" y2="12" transform="rotate(33.75)"/>
                <line y1="-12" y2="12" transform="rotate(56.25)"/>
                <line y1="-12" y2="12" transform="rotate(78.75)"/>
                <line y1="-12" y2="12" transform="rotate(101.25)"/>
                <line y1="-12" y2="12" transform="rotate(123.75)"/>
                <line y1="-12" y2="12" transform="rotate(146.25)"/>
                <line y1="-12" y2="12" transform="rotate(168.75)"/>
              </g>
            </svg>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <div class="quiz__cta-wrapper">
          <a
            {% if section.settings.button_url != blank %}
              href="{{ section.settings.button_url }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
            class="quiz__cta"
          >
            {{ section.settings.button_text }}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Media panel (right on desktop, above on mobile) {%- endcomment -%}
    <div class="quiz__media color-{{ section.settings.media_color_scheme }}">
      {%- if section.settings.background_image != blank -%}
        <div class="quiz__media-bg">
          {{
            section.settings.background_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              class: 'quiz__media-bg-image',
              alt: ''
          }}
        </div>
      {%- endif -%}

      <div class="quiz__gauge">
        <svg class="quiz__gauge-svg" viewBox="0 0 444 258" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="gauge-gradient-{{ section.id }}" x1="0" y1="0" x2="444" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#3383C5" />
              <stop offset="85%" stop-color="#3383C5" />
              <stop offset="100%" stop-color="#C5956A" />
            </linearGradient>
          </defs>
          {%- comment -%} Background track arc {%- endcomment -%}
          <path d="M 30 167 A 222 111 -3 1 1 414 167" stroke="#F2F7FB" stroke-width="8" fill="none" opacity="0.2" stroke-linecap="round"/>
          {%- comment -%} Foreground gradient arc {%- endcomment -%}
          <path d="M 30 167 A 222 111 -3 0 1 387 37" stroke="url(#gauge-gradient-{{ section.id }})" stroke-width="8" fill="none" stroke-linecap="round"/>
        </svg>

        {%- if section.settings.gauge_number != blank -%}
          <p class="quiz__gauge-number">{{ section.settings.gauge_number }}</p>
        {%- endif -%}
      </div>

      <div class="quiz__media-info">
        {%- if section.settings.gauge_label != blank -%}
          <p class="quiz__gauge-label">{{ section.settings.gauge_label }}</p>
        {%- endif -%}
        {%- if section.settings.city_name != blank -%}
          <p class="quiz__city-name">{{ section.settings.city_name }}</p>
        {%- endif -%}
      </div>

      <div class="quiz__dots" aria-hidden="true">
        <span class="quiz__dot quiz__dot--active"></span>
        <span class="quiz__dot"></span>
        <span class="quiz__dot"></span>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /* Split layout */
  .quiz__split {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;

    @media screen and (min-width: 750px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Content panel */
  .quiz__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px 16px;

    @media screen and (min-width: 750px) {
      gap: 32px;
      padding: 48px 40px 48px 15%;
      justify-content: center;
    }
  }

  .quiz__text-group {
    display: flex;
    flex-direction: column;
    gap: 8px;

    @media screen and (min-width: 750px) {
      gap: 16px;
    }
  }

  /* Typography: Subtitle */
  .quiz__subtitle {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 13px;
    line-height: 18px;
    letter-spacing: 0.52px;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 18px;
      line-height: 26px;
      letter-spacing: 0.72px;
    }
  }

  /* Typography: Heading */
  .quiz__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 26px;
    line-height: 34px;
    letter-spacing: -0.52px;
    color: var(--color-foreground);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 42px;
      line-height: 55px;
      letter-spacing: -0.84px;
    }
  }

  /* Typography: Body */
  .quiz__body {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.14px;
    color: var(--color-foreground);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 18px;
      line-height: 25px;
      letter-spacing: 0;
    }
  }

  /* Contaminants card */
  .quiz__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-radius: 5px;
    border: 1px solid rgba(32, 38, 53, 0.12);
    padding: 16px;

    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
      padding: 0;
    }
  }

  .quiz__card-text {
    display: flex;
    flex-direction: column;
    gap: 12px;

    @media screen and (min-width: 750px) {
      flex: 1;
      padding: 24px;
      justify-content: center;
    }
  }

  .quiz__card-label {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 15px;
    line-height: 21px;
    color: var(--color-foreground);
    margin: 0;
  }

  .quiz__card-list {
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 14px;
    line-height: 21px;
    color: var(--color-foreground);
    margin: 0;
  }

  .quiz__card-divider {
    display: none;

    @media screen and (min-width: 750px) {
      display: block;
      width: 1px;
      align-self: stretch;
      background-color: rgba(51, 131, 197, 0.3);
    }
  }

  .quiz__card-icon {
    display: none;

    @media screen and (min-width: 750px) {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 24px;
      flex-shrink: 0;
    }
  }

  /* CTA button */
  .quiz__cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    text-decoration: none;
    cursor: pointer;
    border-radius: 60px;
    padding: 10px 24px 12px;
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: 1px solid var(--color-primary-button-border);
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;

    @media screen and (min-width: 750px) {
      font-size: 16px;
      line-height: 23px;
      border-radius: 57px;
      padding: 10px 34px 13px;
    }

    &:hover {
      background-color: var(--color-primary-button-hover-background);
      color: var(--color-primary-button-hover-text);
      border-color: var(--color-primary-button-hover-border);
    }
  }

  /* Media panel */
  .quiz__media {
    order: -1;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 40px 16px;
    min-height: 318px;
    background-color: var(--color-background);

    @media screen and (min-width: 750px) {
      order: unset;
      min-height: 560px;
      padding: 48px 40px;
      gap: 20px;
    }
  }

  /* Background texture image */
  .quiz__media-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .quiz__media-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.1;
    mix-blend-mode: screen;
    filter: blur(5px);
  }

  /* Gauge */
  .quiz__gauge {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 270px;
    display: flex;
    align-items: center;
    justify-content: center;

    @media screen and (min-width: 750px) {
      max-width: 444px;
    }
  }

  .quiz__gauge-svg {
    width: 100%;
    height: auto;
  }

  .quiz__gauge-number {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -25%);
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 84px;
    line-height: 119px;
    letter-spacing: -1.68px;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 140px;
      line-height: 199px;
      letter-spacing: -2.8px;
    }
  }

  /* Media info text */
  .quiz__media-info {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: center;
  }

  .quiz__gauge-label {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 13px;
    line-height: 18px;
    letter-spacing: 0.52px;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 18px;
      line-height: 26px;
      letter-spacing: 0.72px;
    }
  }

  .quiz__city-name {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 22px;
    line-height: 29px;
    letter-spacing: -0.22px;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;

    @media screen and (min-width: 750px) {
      font-size: 36px;
      line-height: 47px;
      letter-spacing: -0.36px;
    }
  }

  /* Decorative carousel dots */
  .quiz__dots {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 18px;
    align-items: center;
    justify-content: center;
  }

  .quiz__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-foreground);
    opacity: 0.5;
  }

  .quiz__dot--active {
    opacity: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quiz",
  "tag": "section",
  "class": "quiz-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "TAKE THE QUIZ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover what's in your water"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Tap the button below to see the specific contaminants in your local water supply (and how to best protect yourself and your loved ones)."
    },
    {
      "type": "header",
      "content": "Contaminants card"
    },
    {
      "type": "text",
      "id": "contaminants_label",
      "label": "Contaminants label",
      "default": "CONTAMINANTS WE REMOVE: NEW YORK"
    },
    {
      "type": "textarea",
      "id": "contaminants_list",
      "label": "Contaminants list",
      "default": "Haloacetic acids (HAA5), Chromium, Chloroform, Trichloroacetic Acid, Bromoform, 1,4-Dioxane + 5 more."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Take the Quiz"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Gauge"
    },
    {
      "type": "text",
      "id": "gauge_number",
      "label": "Gauge number",
      "default": "14"
    },
    {
      "type": "text",
      "id": "gauge_label",
      "label": "Gauge label",
      "default": "TOTAL CONTAMINANTS FOUND IN:"
    },
    {
      "type": "text",
      "id": "city_name",
      "label": "City name",
      "default": "New York City"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "full-width",
          "label": "Full width"
        },
        {
          "value": "page-width",
          "label": "Page width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "color_scheme",
      "id": "media_color_scheme",
      "label": "Media color scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Quiz"
    }
  ]
}
{% endschema %}
