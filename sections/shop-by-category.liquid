{% liquid
  assign columns = section.settings.columns
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --shop-by-category-columns: {{ columns }};
  "
>
  {% if section.settings.heading != blank %}
    <h2 class="shop-by-category__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="shop-by-category">
    {% for block in section.blocks %}
      {% if block.type == 'category' %}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="shop-by-category__card"
          {{ block.shopify_attributes }}
        >
          <div class="shop-by-category__image-wrapper">
            {% if block.settings.image != blank %}
              {%- assign sizes_val = '(min-width: 750px) 230px, 132px' -%}
              {{
                block.settings.image
                | image_url: width: block.settings.image.width
                | image_tag:
                  sizes: sizes_val,
                  widths: '96,132,168,230,264,460',
                  loading: 'lazy',
                  class: 'shop-by-category__image',
                  alt: block.settings.image.alt
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'shop-by-category__placeholder' }}
            {% endif %}
          </div>
          <span class="shop-by-category__title">{{ block.settings.title | escape }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .shop-by-category {
    display: grid;
    grid-template-columns: repeat(var(--shop-by-category-columns, 6), 1fr);
    gap: 16px;

    @media screen and (max-width: 749px) {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;

      &::-webkit-scrollbar {
        display: none;
      }
    }
  }

  .shop-by-category__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 42px;
    line-height: 55px;
    letter-spacing: -0.84px;
    color: var(--color-foreground);
    margin: 0 0 24px;

    @media screen and (max-width: 749px) {
      font-size: 26px;
      line-height: 34px;
      letter-spacing: -0.52px;
    }
  }

  .shop-by-category__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: var(--color-foreground);

    @media screen and (max-width: 749px) {
      flex: 0 0 132px;
      gap: 6px;
    }
  }

  .shop-by-category__image-wrapper {
    aspect-ratio: 1;
    overflow: hidden;
    background-color: #F2F7FB;
    display: flex;
    align-items: center;
    justify-content: center;

    @media screen and (max-width: 749px) {
      border-radius: 5px;
    }
  }

  .shop-by-category__image {
    width: 73%;
    height: 73%;
    object-fit: contain;
  }

  .shop-by-category__placeholder {
    width: 73%;
    height: 73%;
  }

  .shop-by-category__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 18px;
    line-height: 25px;
    text-align: center;
    color: var(--color-foreground);

    @media screen and (max-width: 749px) {
      font-size: 14px;
      line-height: 20px;
      letter-spacing: -0.14px;
      text-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "shop-by-category-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 65
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 65
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Shop by Category"
    }
  ]
}
{% endschema %}
